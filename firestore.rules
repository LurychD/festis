rules_version = '2';
service cloud.firestore {
  // Reglas de seguridad para la base de datos multi-tenant 'festis-db-a'
  match /databases/{database}/documents {

    // Funciones globales de autenticación e identidad
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserEmail(email) {
      return isSignedIn() && (
        request.auth.token.email == email ||
        request.auth.uid == email ||
        isAdmin()
      );
    }

    // Administrador exclusivo del sistema: Axel Ibarra
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'axeldibarra@gmail.com' ||
        request.auth.uid == 'IslcgZ6p0hRom8hSsZ9scw30tD12'
      );
    }

    // Validador de formato seguro para IDs de documentos
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$');
    }

    // Documento del proyecto activo
    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    // 1. Jerarquía RBAC Multi-Tenant por UID
    // Rol: Owner (Control total, miembros, configuración y borrado)
    function isOwner(projectId) {
      return isSignedIn() && (
        isAdmin() ||
        (projectDoc(projectId).ownerUids is list && request.auth.uid in projectDoc(projectId).ownerUids) ||
        (request.auth.token.email != null && projectDoc(projectId).createdBy == request.auth.token.email)
      );
    }

    // Rol: Distribuidor (Gestión de festivales, postulaciones y planes de distribución)
    function isDistributor(projectId) {
      return isOwner(projectId) || (
        isSignedIn() &&
        projectDoc(projectId).distributorUids is list &&
        request.auth.uid in projectDoc(projectId).distributorUids
      );
    }

    // Rol: Colaborador (Roadmap, notas, bitácora y recordatorios)
    function isCollaborator(projectId) {
      return isDistributor(projectId) || (
        isSignedIn() &&
        projectDoc(projectId).collaboratorUids is list &&
        request.auth.uid in projectDoc(projectId).collaboratorUids
      );
    }

    // Rol: Guest / Invitado (Solo lectura de la obra)
    function isMember(projectId) {
      return isCollaborator(projectId) || (
        isSignedIn() && (
          (projectDoc(projectId).guestUids is list && request.auth.uid in projectDoc(projectId).guestUids) ||
          (request.auth.token.email != null && (
            projectDoc(projectId).createdBy == request.auth.token.email ||
            (projectDoc(projectId).authorizedUsers is list && (
              request.auth.token.email in projectDoc(projectId).authorizedUsers ||
              projectDoc(projectId).authorizedUsers.hasAny([request.auth.token.email])
            ))
          ))
        )
      );
    }

    // Colección raíz de Proyectos (/projects/{projectId})
    match /projects/{projectId} {
      // Lectura permitida a cualquier miembro perteneciente a la obra o admin
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.token.email ||
        (resource.data.ownerUids is list && request.auth.uid in resource.data.ownerUids) ||
        (resource.data.distributorUids is list && request.auth.uid in resource.data.distributorUids) ||
        (resource.data.collaboratorUids is list && request.auth.uid in resource.data.collaboratorUids) ||
        (resource.data.guestUids is list && request.auth.uid in resource.data.guestUids) ||
        (resource.data.authorizedUsers is list && (
          request.auth.token.email in resource.data.authorizedUsers ||
          resource.data.authorizedUsers.hasAny([request.auth.token.email])
        ))
      );

      // Creación: usuarios autenticados que se declaren creadores
      allow create: if isSignedIn() 
        && isValidId(projectId)
        && (
          isAdmin() ||
          (request.auth.token.email != null && request.resource.data.createdBy == request.auth.token.email)
        );

      // Modificación de configuración y miembros: Exclusivo de Owners y Admin
      allow update: if isOwner(projectId);

      // Eliminación del proyecto: Exclusivo del creador original o Admin
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && resource.data.createdBy == request.auth.token.email)
      );

      // 2. Subcolecciones con permisos granulares por rol

      // Festivales y postulaciones: Distribuidor y Owner
      match /festivals/{festivalId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isDistributor(projectId);
      }

      // Planes de distribución y estrategias: Distribuidor y Owner
      match /distribution_plans/{planId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isDistributor(projectId);
      }

      // Publicaciones de redes sociales vinculadas a la obra: Distribuidor y Owner
      match /social_posts/{postId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isDistributor(projectId);
      }

      // Ficha técnica y datos maestros de la película: Exclusivo de Owner
      match /film_data/{filmDocId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isOwner(projectId);
      }

      // Galería y material gráfico de la obra: Exclusivo de Owner
      match /gallery/{galleryId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isOwner(projectId);
      }

      // Instituciones y contactos: Distribuidor y Owner
      match /institutions/{instId} {
        allow read: if isMember(projectId);
        allow create, update, delete: if isDistributor(projectId);
      }

      // Roadmap, notas, recordatorios y reportes de errores: Colaborador, Distribuidor y Owner
      match /roadmap/{itemId} {
        allow read, write: if isCollaborator(projectId);
      }
      match /notes/{noteId} {
        allow read, write: if isCollaborator(projectId);
      }
      match /reminders/{reminderId} {
        allow read, write: if isCollaborator(projectId);
      }
      match /bugs/{bugId} {
        allow read, write: if isCollaborator(projectId);
      }

      // Subcolecciones adicionales recursivas por defecto
      match /{document=**} {
        allow read: if isMember(projectId);
        allow write: if isOwner(projectId);
      }
    }

    // 3. Colecciones de catálogo o globales compartidas
    match /platforms/{platId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /auditlogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /authmembers/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fcm_tokens/{email} {
      allow read, write: if isUserEmail(email) || isAdmin();
    }

    match /user_easter_eggs/{email} {
      allow read, write: if isUserEmail(email) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email == userId) ||
        isAdmin()
      );
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /social_posts/{postId} {
      allow read, write: if isSignedIn();
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /user_notif_prefs/{userId} {
      allow read, write: if isUserEmail(userId) || isAdmin();
    }

    // Colección de Invitaciones Mágicas para Obras
    match /project_invitations/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Cierre seguro
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
