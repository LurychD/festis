rules_version = '2';
service firebase.storage {
  // Reglas de seguridad para el bucket multi-tenant 'festis-bucket-a'
  match /b/festis-bucket-a/o {
    match /projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 15 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }

  // Reglas globales de respaldo para cualquier bucket del proyecto
  match /b/{bucket}/o {
    match /projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 15 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
