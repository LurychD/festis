# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# IA Search and Groq Configuration
GROQ_API_KEY=""
HF_TOKEN="" # Hugging Face API token for file/flyer parsing (Vision API, e.g. Llama 3.2 Vision)

# Firebase Cloud Messaging
VITE_FCM_VAPID_KEY=""

# Firebase Admin Service Account Key (JSON stringified)
# Required to access Firestore backend and send Push Notifications
FIREBASE_SERVICE_ACCOUNT=""

# Secret Key para Autenticar el SDK Backend de Gemini Spark en Modo Lectura
SPARK_API_SECRET=""
